import InitECandidate.Solver.GuestBound.MillerSteps

/-!
# `bn254_miller_raw` keeps coefficients below `p`

Generated by `tools/gen-miller.py` from `tools/miller.template` (the step
lists follow the source of `bn254_miller_raw`). Canonical points `Q`, `P` give
canonical `fnum`, `fden`. Part of the canonicity chain for `fq12_inv`
(issue #19).
-/

namespace InitECandidate.Solver.GuestBound
open Flapjack

variable {σ : Type} {E : Env σ} {s : St σ} {Q : Result σ → Prop}
  {m m' m0 : Word → Option (PanValue Word)} {Wr : List Word}

set_option maxHeartbeats 128000000 in
theorem bn254_miller_raw_bufs (hE : GuestEnv E) (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "bn254_miller_raw" E.functions = some (parameters, body))
    (s : St σ) (r : Result σ) (Fn Fd Qp Pp Gt hp pv0 : Word)
    (m0 : Word → Option (PanValue Word)) (Wr All Cn : List Word)
    (hfnum : s.locals "fnum" = some (.word Fn)) (hfden : s.locals "fden" = some (.word Fd))
    (hQ : s.locals "Q" = some (.word Qp)) (hP : s.locals "P" = some (.word Pp))
    (hg : s.globals "heap_ptr" = some (.word hp))
    (hgm : s.globals "bn_gamma" = some (.word Gt))
    (hB0 : Bufs pv0 m0 Wr hp All Cn s.memory)
    (qa : Qp ∈ Cn) (qb : Qp + 384#64 ∈ Cn) (qc : Qp + 768#64 ∈ Cn)
    (pa : Pp ∈ Cn) (pb : Pp + 384#64 ∈ Cn) (pc : Pp + 768#64 ∈ Cn)
    (hGt : Gt ∈ Cn) (hFn : Fn ∈ All) (hFd : Fd ∈ All)
    (wFn : pv0.toNat ≤ Fn.toNat ∨ Fn ∈ Wr) (wFd : pv0.toNat ≤ Fd.toNat ∨ Fd ∈ Wr)
    (h : Runs E s body r) :
    Stopped r ∨ BufsRet s pv0 m0 Wr hp All (Fn :: Fd :: Cn) r := by
  have hbody := (fun_of_index 684 hE.functions (by guest_decl_at 684) (by decide +kernel)
    hlookup).1
  subst hbody
  dsimp only at h
  have hpb0 := hB0.hpb
  have gGt := hB0.geo Gt (hB0.sub Gt hGt)
  have gQ0 := hB0.geo Qp (hB0.sub Qp qa)
  have gQ2 := hB0.geo _ (hB0.sub _ qc)
  have hq2 : (Qp + 768#64).toNat = Qp.toNat + 768 :=
    add_lit_toNat (k := 768) (by omega) (by omega)
  have hnat : ∀ n : Nat, n < 100 → (BitVec.ofNat 64 n : Word).toNat = n := by
    intro n hn
    rw [BitVec.toNat_ofNat]
    omega
  refine (?_ : WPs E s _ (BufsRet s pv0 m0 Wr hp All (Fn :: Fd :: Cn))) r h
  refine WPs.decCall_ret (fun v g m ffi hret => ?_)
  obtain ⟨hg', hm, hf, hv⟩ := heap_mark_ret hE hret hg
  simp only [List.cons.injEq, and_true] at hv
  subst g m ffi v
  try dsimp only
  have hB := hB0
  refine WPs.pt_alloc_step hE (eval_const _ _) hg hB (fun q1 l0 a0 t0a t0b hB => ?_)
  try dsimp only
  refine WPs.pt_alloc_step hE (eval_const _ _) (by lk []) hB (fun q2 l1 a1 t1a t1b hB => ?_)
  try dsimp only
  refine WPs.pt_alloc_step hE (eval_const _ _) (by lk []) hB (fun q3 l2 a2 t2a t2b hB => ?_)
  try dsimp only
  refine WPs.pt_alloc_step hE (eval_const _ _) (by lk []) hB (fun q4 l3 a3 t3a t3b hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_step hE (eval_const _ _) (by lk []) hB (fun q5 l4 a4 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_step hE (eval_const _ _) (by lk []) hB (fun q6 l5 a5 hB => ?_)
  try dsimp only
  generalize hL : updatePanValueMap _ "d" (PanValue.word q5) = L
  generalize hG : updatePanValueMap _ "heap_ptr" (PanValue.word q6) = G
  have hGq : G "heap_ptr" = some (.word q6) := by rw [← hG]; lk []
  have hgG : G "bn_gamma" = some (.word Gt) := by rw [← hG]; lk [hgm]
LOOKUPS_L
  -- R = Q, nQ = -Q, fnum = fden = 1
  refine WPs.pt_copy_step hE (O := hp) (P := Qp) (by lk [L_R]) (by lk [L_Q]) (eval_const _ _) hB
    (by simp [qa]) (by simp [qb]) (by simp [qc]) (by simp) (by simp) (by simp) (Or.inl l0)
    (Or.inl (by omega)) (Or.inl (by omega)) (Or.inr (Or.inr (by omega))) (fun m hB => ?_)
  try dsimp only
  refine WPs.pt_copy_step hE (O := q1) (P := Qp) (by lk [L_nQ]) (by lk [L_Q]) (eval_const _ _) hB
    (by simp [qa]) (by simp [qb]) (by simp [qc]) (by simp) (by simp) (by simp) (Or.inl l1)
    (Or.inl (by omega)) (Or.inl (by omega)) (Or.inr (Or.inr (by omega))) (fun m hB => ?_)
  try dsimp only
  refine WPs.fe_neg_step hE (D := q1 + 384#64) (A := Qp + 384#64) (eval_const _ _)
    (by ev [L_nQ]) (by ev [L_Q]) hB (by simp) (Or.inl (by omega)) (by simp [qb]) (fun m hB => ?_)
  try dsimp only
  refine WPs.fe_set_one_step hE (D := Fn) (eval_const _ _) (by lk [L_fnum]) hB (by simp [hFn]) wFn
    (fun m hB => ?_)
  try dsimp only
  refine WPs.fe_set_one_step hE (D := Fd) (eval_const _ _) (by lk [L_fden]) hB (by simp [hFd]) wFd
    (fun m hB => ?_)
  try dsimp only
  refine WPs.dec (w := 64#64) (of_eval (eval_const _ _)) ?_
  obtain ⟨L2, hL2⟩ : ∃ L2, L2 = updatePanValueMap L "i" (.word 64#64) := ⟨_, rfl⟩
  rw [← hL2]
LOOKUPS_L2
  refine WPs.seqG
    (fun st => st.globals = G ∧ st.ffi = s.ffi ∧ (∀ x, x ≠ "i" → st.locals x = L2 x) ∧
      (∃ j, st.locals "i" = some (.word (BitVec.ofNat 64 j)) ∧ j ≤ 64) ∧
      Bufs pv0 m0 Wr q6 _ _ st.memory)
    (WPs.loopG
      (I := fun st => st.globals = G ∧ st.ffi = s.ffi ∧ (∀ x, x ≠ "i" → st.locals x = L2 x) ∧
        (∃ j, st.locals "i" = some (.word (BitVec.ofNat 64 j)) ∧ j ≤ 64) ∧
        Bufs pv0 m0 Wr q6 _ _ st.memory)
      ⟨rfl, rfl, fun _ _ => rfl, ⟨64, by rw [hL2]; lk [], by omega⟩, hB⟩ ?_
      (fun a k hI _ => hI)) ?_
  · rintro ⟨la, ga, ma, fa⟩ ⟨hg', hf, hloc, ⟨j, hj, hj64⟩, hB⟩ ⟨w, cc, hcond, hw⟩
    simp only at hg' hf hloc hj hB
    subst ga fa
    have hcv := eval_cmp_inv hE (op := .lower) (of_eval (w := 0#64) (eval_const _ _))
      (of_eval (w := BitVec.ofNat 64 j) (by lk [hj])) _ (cond_of_eval hcond)
    simp only [PanValue.word.injEq] at hcv
    have hj1 : 1 ≤ j := by
      by_contra hlt0
      have hl : ¬ (0#64 : Word) < BitVec.ofNat 64 j := by
        rw [BitVec.lt_def, hnat j (by omega)]
        simp
        omega
      rw [hcv] at hw
      simp [evalPanCmp, hl] at hw
    obtain ⟨k, rfl⟩ : ∃ k, j = k + 1 := ⟨j - 1, by omega⟩
    have hpred : (BitVec.ofNat 64 (k + 1) : Word) - 1#64 = BitVec.ofNat 64 k := by
      apply BitVec.eq_of_toNat_eq
      simp only [BitVec.toNat_sub, BitVec.toNat_ofNat]
      omega
    refine WPs.seq_assign (old := BitVec.ofNat 64 (k + 1)) (w := BitVec.ofNat 64 k) hj
      (of_eval (by ev [hj, hpred])) ?_
    try dsimp only
    generalize hLc : updatePanValueMap la "i" (PanValue.word (BitVec.ofNat 64 k)) = Lc
    have hlocC : ∀ x, x ≠ "i" → Lc x = L2 x := by
      intro x hx
      rw [← hLc, update_lookup, if_neg (by simpa using hx)]
      exact hloc x hx
    have hik : Lc "i" = some (.word (BitVec.ofNat 64 k)) := by rw [← hLc]; lk []
LOOKUPS_LC
BODY
    refine WPs.seq (fun st => ∃ m, st = ⟨Lc, G, m, s.ffi⟩ ∧ Bufs pv0 m0 Wr q6
        (ALLI)
        (CNM) m)
      (WPs.ite_both (fun w1 _ => ?_)) ?_
    · split
      · exact WPs.skip ⟨_, _, _, _, rfl, m, rfl, hB⟩
      · try dsimp only
BR1
        exact WPs.skip ⟨_, _, _, _, rfl, m, rfl, hB.mono (fun B hB' => by
          simp only [List.mem_cons] at hB'
          repeat (rcases hB' with h | hB'; (subst h; simp); skip)
          simp [hB'])⟩
    rintro _ ⟨m, rfl, hB⟩
    refine WPs.ite_both (fun w2 _ => ?_)
    split
    · exact WPs.skip ⟨rfl, rfl, hlocC, ⟨k, hik, by omega⟩, hB.mono (fun B hB' => by
        simp only [List.mem_cons] at hB'
        repeat (rcases hB' with h | hB'; (subst h; simp); skip)
        simp [hB'])⟩
    · try dsimp only
BR2
      exact WPs.skip ⟨rfl, rfl, hlocC, ⟨k, hik, by omega⟩, hB.mono (fun B hB' => by
        simp only [List.mem_cons] at hB'
        repeat (rcases hB' with h | hB'; (subst h; simp); skip)
        simp [hB'])⟩
  rintro ⟨la, ga, ma, fa⟩ ⟨hg', hf, hloc, -, hB⟩
  simp only at hg' hf hloc hB
  subst ga fa
  obtain ⟨m, hm⟩ : ∃ m, m = ma := ⟨_, rfl⟩
  rw [← hm] at hB ⊢
LOOKUPS_LA
TAIL
  refine WPs.seq_call_ret (fun vs g m4 ffi hret => ?_)
  obtain ⟨hg', hm', hf⟩ := release_ret hE hret (mv := hp) (pv := q6) (by lk [La_mark]) hGq
  subst g m4 ffi
  refine WPs.ret (of_eval (eval_const _ _)) ?_
  simp only [restorePanValueFfiLocal, ← hG, hp_update_update]
  rw [update_same _ _ _ hg]
  refine ⟨_, m, rfl, Bufs.restrict hB0 hB (fun B hB' => ?_)⟩
  simp only [List.mem_cons] at hB'
  rcases hB' with rfl | rfl | hB'
  · exact ⟨hFn, by simp⟩
  · exact ⟨hFd, by simp⟩
  · exact ⟨hB0.sub B hB', by simp [hB']⟩

end InitECandidate.Solver.GuestBound

    Stopped r ∨ BufsRetK s K pv0 m0 Wr hp All ((O + 2#64 * (F * 32#64)) :: (O + F * 32#64) :: O :: Cn) r := by
  have hbody := (fun_of_index 674 hE.functions (by guest_decl_at 674) (by decide +kernel)
    hlookup).1
  subst hbody
  dsimp only at h
  have hK12 : K ≤ 12 := by omega
  have hK1 : 1 ≤ K := by omega
  have hez := esz_toNat hF hK12
  have gO0 := hB0.geo O hO0
  have gO1 := hB0.geo _ hO1
  have gO2 := hB0.geo _ hO2
  have hquiet := keepFn_sound (quietKeeper E) hE.functions 2 "fe_is_zero" fe_is_zero_quiet
  have hquiet2 := keepFn_sound (quietKeeper E) hE.functions 2 "fe_eq" fe_eq_quiet
  refine (?_ : WPs E s _ (BufsRetK s K pv0 m0 Wr hp All
    ((O + 2#64 * (F * 32#64)) :: (O + F * 32#64) :: O :: Cn))) r h
  refine WPs.dec (w := F * 32#64) (of_eval (by ev [evalPanOp, hfld])) ?_
  -- p1 at infinity: out = p2
  refine WPs.decCall_ret (fun v g m ffi hret => ?_)
  obtain ⟨hg', hm, hf⟩ := hret.quiet hquiet
  subst g m ffi
  try dsimp only
  generalize hLa : updatePanValueMap _ "z1z" v = La
LOOKUPS_A
  refine WPs.seqG (fun st => st = ⟨La, s.globals, s.memory, s.ffi⟩)
    (WPs.ite_both (fun w _ => ?_)) ?_
  · split
    · exact WPs.skip rfl
    · refine WPs.pt_copy_stepK hE hF hK (O := O) (P := P2) (by lk [La_out]) (by lk [La_p2])
        (by rw [← hLa]; ev [evalPanOp]) hB0 m2a m2b m2c hO0 hO1 hO2 w0 w1 w2 rel2
        (fun m hB => ?_)
      refine WPs.ret (of_eval (eval_const _ _)) ?_
      simp only [restorePanValueFfiLocal]
      exact ⟨_, m, rfl, hB⟩
  rintro _ rfl
  -- p2 at infinity: out = p1
  refine WPs.decCall_ret (fun v' g m ffi hret => ?_)
  obtain ⟨hg', hm, hf⟩ := hret.quiet hquiet
  subst g m ffi
  try dsimp only
  generalize hLb : updatePanValueMap _ "z2z" v' = Lb
LOOKUPS_B
  refine WPs.seqG (fun st => st = ⟨Lb, s.globals, s.memory, s.ffi⟩)
    (WPs.ite_both (fun w _ => ?_)) ?_
  · split
    · exact WPs.skip rfl
    · refine WPs.pt_copy_stepK hE hF hK (O := O) (P := P1) (by lk [Lb_out]) (by lk [Lb_p1])
        (by rw [← hLb, ← hLa]; ev [evalPanOp]) hB0 m1a m1b m1c hO0 hO1 hO2 w0 w1 w2 rel1
        (fun m hB => ?_)
      refine WPs.ret (of_eval (eval_const _ _)) ?_
      simp only [restorePanValueFfiLocal]
      exact ⟨_, m, rfl, hB⟩
  rintro _ rfl
  have Lb_esz : Lb "esz" = some (.word (F * 32#64)) := by rw [← hLb, ← hLa]; lk []
  refine WPs.decCall_ret (fun vm g m ffi hret => ?_)
  obtain ⟨hg', hm, hf, hv⟩ := heap_mark_ret hE hret hg
  simp only [List.cons.injEq, and_true] at hv
  subst g m ffi vm
  refine WPs.dec (w := P1) (of_eval (by lk [Lb_p1])) ?_
  refine WPs.dec (w := P1 + F * 32#64) (of_eval (by ev [Lb_p1, Lb_esz])) ?_
  refine WPs.dec (w := P1 + 2#64 * (F * 32#64)) (of_eval (by ev [evalPanOp, Lb_p1, Lb_esz])) ?_
  refine WPs.dec (w := P2) (of_eval (by lk [Lb_p2])) ?_
  refine WPs.dec (w := P2 + F * 32#64) (of_eval (by ev [Lb_p2, Lb_esz])) ?_
  refine WPs.dec (w := P2 + 2#64 * (F * 32#64)) (of_eval (by ev [evalPanOp, Lb_p2, Lb_esz])) ?_
  try dsimp only
  have hB := hB0
  refine WPs.fe_alloc_stepK hE hez (by lk [Lb_esz]) hg hB (fun q1 l0 a0 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [Lb_esz]) (by lk []) hB (fun q2 l1 a1 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [Lb_esz]) (by lk []) hB (fun q3 l2 a2 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [Lb_esz]) (by lk []) hB (fun q4 l3 a3 hB => ?_)
  try dsimp only
  generalize hL1 : updatePanValueMap _ "V2" (PanValue.word q3) = L1
  generalize hG1 : updatePanValueMap _ "heap_ptr" (PanValue.word q4) = G1
  have hG1q : G1 "heap_ptr" = some (.word q4) := by rw [← hG1]; lk []
  have L1_esz : L1 "esz" = some (.word (F * 32#64)) := by rw [← hL1]; lk [Lb_esz]
LOOKUPS_1
STEPS_1
  -- equal x coordinates: double or infinity
  refine WPs.decCall_ret (fun v3 g m' ffi hret => ?_)
  obtain ⟨hg', hm, hf⟩ := hret.quiet hquiet2
  subst g m' ffi
  try dsimp only
  refine WPs.seqG (fun st => ∃ m, st = ⟨updatePanValueMap L1 "veq" v3, G1, m, s.ffi⟩ ∧
      BufsK K pv0 m0 Wr q4 (q3 :: q2 :: q1 :: hp :: All) (q3 :: q2 :: q1 :: hp :: Cn) m)
    (WPs.ite_both (fun w _ => ?_)) ?_
  · split
    · exact WPs.skip ⟨m, rfl, hB⟩
    · refine WPs.decCall_ret (fun v4 g m' ffi hret => ?_)
      obtain ⟨hg', hm, hf⟩ := hret.quiet hquiet2
      subst g m' ffi
      try dsimp only
      generalize hLc : updatePanValueMap _ "ueq" v4 = Lc
LOOKUPS_C
      have Lc_mark : Lc "mark" = some (.word hp) := by rw [← hLc]; lk [L1_mark]
      refine WPs.seq_call_ret (fun vs g m4 ffi hret => ?_)
      obtain ⟨hg', hm, hf⟩ := release_ret hE hret (mv := hp) (pv := q4) (by lk [Lc_mark]) hG1q
      subst g m4 ffi
      have hBr : BufsK K pv0 m0 Wr hp All Cn m :=
        BufsK.restrict hB0 hB (fun B hB' => ⟨hB0.sub B hB', by simp [hB']⟩)
      simp only [← hG1, hp_update_update]
      rw [update_same _ _ _ hg]
      refine WPs.seqG (fun st => st = ⟨Lc, s.globals, m, s.ffi⟩)
        (WPs.ite_both (fun w' _ => ?_)) ?_
      · split
        · exact WPs.skip rfl
        · refine WPs.ecp_double_stepK hE hF hK (O := O) (P := P1) (by lk [Lc_fld]) (by lk [Lc_out])
            (by lk [Lc_p1]) hg hBr m1a m1b m1c hO0 hO1 hO2 w0 w1 w2 (fun m' hB' => ?_)
          refine WPs.ret (of_eval (eval_const _ _)) ?_
          simp only [restorePanValueFfiLocal]
          exact ⟨_, m', rfl, hB'⟩
      rintro _ rfl
      refine WPs.ecp_set_inf_stepK hE hF hK (O := O) (by lk [Lc_fld]) (by lk [Lc_out]) hBr hO0 hO1 hO2
        w0 w1 w2 (fun m' hB' => ?_)
      refine WPs.ret (of_eval (eval_const _ _)) ?_
      simp only [restorePanValueFfiLocal]
      exact ⟨_, m', rfl, hB'⟩
  rintro _ ⟨m, rfl, hB⟩
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [L1_esz]) hG1q hB (fun q5 l4 a4 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [L1_esz]) (by lk []) hB (fun q6 l5 a5 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [L1_esz]) (by lk []) hB (fun q7 l6 a6 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [L1_esz]) (by lk []) hB (fun q8 l7 a7 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [L1_esz]) (by lk []) hB (fun q9 l8 a8 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [L1_esz]) (by lk []) hB (fun q10 l9 a9 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [L1_esz]) (by lk []) hB (fun q11 l10 a10 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_stepK hE hez (by lk [L1_esz]) (by lk []) hB (fun q12 l11 a11 hB => ?_)
  try dsimp only
  generalize hL2 : updatePanValueMap _ "T" (PanValue.word q11) = L2
  generalize hG2 : updatePanValueMap _ "heap_ptr" (PanValue.word q12) = G2
  have hG2q : G2 "heap_ptr" = some (.word q12) := by rw [← hG2]; lk []
  have L2_esz : L2 "esz" = some (.word (F * 32#64)) := by rw [← hL2]; lk [L1_esz]
LOOKUPS_2
STEPS_2
  -- copies into the output point
  refine WPs.fe_copy_stepK hE hez (D := O) (S := q11) (by lk [L2_out]) (by lk [L2_T])
    (by lk [L2_esz]) hB (by simp [hO0]) w0 (by simp)
    (fun e => by have := congrArg BitVec.toNat e; omega) (fun m hB => ?_)
  try dsimp only
  refine WPs.fe_copy_stepK hE hez (D := O + F * 32#64) (S := q5) (by ev [L2_out, L2_esz]) (by lk [L2_V])
    (by lk [L2_esz]) hB (by simp [hO1]) w1 (by simp)
    (fun e => by have := congrArg BitVec.toNat e; omega) (fun m hB => ?_)
  try dsimp only
  refine WPs.fe_copy_stepK hE hez (D := O + 2#64 * (F * 32#64)) (S := q9) (by ev [evalPanOp, L2_out, L2_esz])
    (by lk [L2_W]) (by lk [L2_esz]) hB (by simp [hO2]) w2 (by simp)
    (fun e => by have := congrArg BitVec.toNat e; omega) (fun m hB => ?_)
  try dsimp only
  refine WPs.seq_call_ret (fun vs g m4 ffi hret => ?_)
  obtain ⟨hg', hm, hf⟩ := release_ret hE hret (mv := hp) (pv := q12) (by lk [L2_mark]) hG2q
  subst g m4 ffi
  refine WPs.ret (of_eval (eval_const _ _)) ?_
  simp only [restorePanValueFfiLocal, ← hG2, ← hG1, hp_update_update]
  rw [update_same _ _ _ hg]
  refine ⟨_, m, rfl, BufsK.restrict hB0 hB (fun B hB' => ?_)⟩
  simp only [List.mem_cons] at hB'
  rcases hB' with rfl | rfl | rfl | hB'
  · exact ⟨hO2, by simp⟩
  · exact ⟨hO1, by simp⟩
  · exact ⟨hO0, by simp⟩
  · exact ⟨hB0.sub B hB', by simp [hB']⟩

end InitECandidate.Solver.GuestBound

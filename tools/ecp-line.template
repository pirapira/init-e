import InitECandidate.Solver.GuestBound.FeSet

/-!
# `ecp_linefunc` on `Fq12` points keeps coefficients below `p`

Generated by `tools/gen-ecp-line.py` from `tools/ecp-line.template` (the step
lists follow the source of `ecp_linefunc`). Part of the canonicity chain for
`fq12_inv` (issue #19).
-/

namespace InitECandidate.Solver.GuestBound
open Flapjack

variable {σ : Type} {E : Env σ} {s : St σ} {Q : Result σ → Prop}
  {m m' m0 : Word → Option (PanValue Word)} {Wr : List Word}

/-- A statement behaves like itself followed by `skip`. -/
theorem WPs.of_seq_skip {p : Prog Word} (h : WPs E s (.seq p .skip) Q) : WPs E s p Q := by
  intro r hr
  refine h r (runs_seq.mpr ⟨r, hr, ?_⟩)
  cases r <;> first | exact runs_skip.mpr rfl | rfl

set_option maxHeartbeats 64000000 in
theorem ecp_linefunc12_bufs (hE : GuestEnv E) (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "ecp_linefunc" E.functions = some (parameters, body))
    (s : St σ) (r : Result σ) (N Dn P1 P2 T hp pv0 : Word)
    (m0 : Word → Option (PanValue Word)) (Wr All Cn : List Word)
    (hfld : s.locals "fld" = some (.word 12#64)) (hnum : s.locals "num" = some (.word N))
    (hden : s.locals "den" = some (.word Dn)) (hP1 : s.locals "P1" = some (.word P1))
    (hP2 : s.locals "P2" = some (.word P2)) (hT : s.locals "T" = some (.word T))
    (hg : s.globals "heap_ptr" = some (.word hp))
    (hB0 : Bufs pv0 m0 Wr hp All Cn s.memory)
    (m1a : P1 ∈ Cn) (m1b : P1 + 384#64 ∈ Cn) (m1c : P1 + 768#64 ∈ Cn)
    (m2a : P2 ∈ Cn) (m2b : P2 + 384#64 ∈ Cn) (m2c : P2 + 768#64 ∈ Cn)
    (mta : T ∈ Cn) (mtb : T + 384#64 ∈ Cn) (mtc : T + 768#64 ∈ Cn)
    (hN : N ∈ All) (hD : Dn ∈ All)
    (wN : pv0.toNat ≤ N.toNat ∨ N ∈ Wr) (wD : pv0.toNat ≤ Dn.toNat ∨ Dn ∈ Wr)
    (h : Runs E s body r) :
    Stopped r ∨ BufsRet s pv0 m0 Wr hp All (N :: Dn :: Cn) r := by
  have hbody := (fun_of_index 676 hE.functions (by guest_decl_at 676) (by decide +kernel)
    hlookup).1
  subst hbody
  dsimp only at h
  refine (?_ : WPs E s _ (BufsRet s pv0 m0 Wr hp All (N :: Dn :: Cn))) r h
  refine WPs.dec (w := 384#64) (of_eval (by ev [evalPanOp, hfld])) ?_
  refine WPs.decCall_ret (fun v g m ffi hret => ?_)
  obtain ⟨hg', hm, hf, hv⟩ := heap_mark_ret hE hret hg
  simp only [List.cons.injEq, and_true] at hv
  subst g m ffi v
  refine WPs.dec (w := P1) (of_eval (by lk [hP1])) ?_
  refine WPs.dec (w := P1 + 384#64) (of_eval (by ev [hP1])) ?_
  refine WPs.dec (w := P1 + 768#64) (of_eval (by ev [evalPanOp, hP1])) ?_
  refine WPs.dec (w := P2) (of_eval (by lk [hP2])) ?_
  refine WPs.dec (w := P2 + 384#64) (of_eval (by ev [hP2])) ?_
  refine WPs.dec (w := P2 + 768#64) (of_eval (by ev [evalPanOp, hP2])) ?_
  refine WPs.dec (w := T) (of_eval (by lk [hT])) ?_
  refine WPs.dec (w := T + 384#64) (of_eval (by ev [hT])) ?_
  refine WPs.dec (w := T + 768#64) (of_eval (by ev [evalPanOp, hT])) ?_
  try dsimp only
  have hB := hB0
  refine WPs.fe_alloc_step hE (by lk []) hg hB (fun q1 l0 a0 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_step hE (by lk []) (by lk []) hB (fun q2 l1 a1 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_step hE (by lk []) (by lk []) hB (fun q3 l2 a2 hB => ?_)
  try dsimp only
  refine WPs.fe_alloc_step hE (by lk []) (by lk []) hB (fun q4 l3 a3 hB => ?_)
  try dsimp only
  generalize hL : updatePanValueMap _ "t2" (PanValue.word q3) = L
  generalize hG : updatePanValueMap _ "heap_ptr" (PanValue.word q4) = G
  have hGq : G "heap_ptr" = some (.word q4) := by rw [← hG]; lk []
LOOKUPS
  -- the slope: zero for P1 == P2, else (y2 z1 - y1 z2) / (x2 z1 - x1 z2)
  refine WPs.seq (fun st => ∃ m, st = ⟨L, G, m, s.ffi⟩ ∧
      Bufs pv0 m0 Wr q4 (q3 :: q2 :: q1 :: hp :: All) (hp :: q1 :: Cn) m)
    (WPs.ite_both (fun w _ => ?_)) ?_
  · split
    · try dsimp only
A_ELSE
      exact WPs.skip ⟨_, _, _, _, rfl, m, rfl, hB.mono MONO6⟩
    · try dsimp only
A_THEN
      exact WPs.skip ⟨_, _, _, _, rfl, m, rfl, hB.mono MONO6⟩
  rintro _ ⟨m, rfl, hB⟩
  refine WPs.decCall_ret (fun v g m' ffi hret => ?_)
  obtain ⟨hg', hm, hf⟩ := hret.quiet
    (keepFn_sound (quietKeeper E) hE.functions 2 "fe_is_zero" fe_is_zero_quiet)
  subst g m' ffi
  try dsimp only
  refine WPs.seqG (fun st => ∃ m, st = ⟨updatePanValueMap L "mdz" v, G, m, s.ffi⟩ ∧
      Bufs pv0 m0 Wr q4 (q3 :: q2 :: q1 :: hp :: All) (hp :: q1 :: Cn) m)
    (WPs.ite_both (fun w _ => ?_)) ?_
  · split
    · exact WPs.skip ⟨m, rfl, hB⟩
    · refine WPs.decCall_ret (fun v2 g m' ffi hret => ?_)
      obtain ⟨hg', hm, hf⟩ := hret.quiet
        (keepFn_sound (quietKeeper E) hE.functions 2 "fe_is_zero" fe_is_zero_quiet)
      subst g m' ffi
      try dsimp only
      refine WPs.ite_both (fun w2 _ => ?_)
      split
      · try dsimp only
B_RET
      · try dsimp only
B_TT
        refine WPs.skip ?_
        simp only [restorePanValueFfiLocal, restore_update]
        exact ⟨m, rfl, hB.mono MONO8⟩
  rintro _ ⟨m, rfl, hB⟩
  try dsimp only
C_STEPS

end InitECandidate.Solver.GuestBound

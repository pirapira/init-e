import InitECandidate.Solver.GuestBound.PairingGeo

/-!
# `bn254_pairing_check`: one round of its loop

Generated by `tools/gen-pairing-round.py` from `tools/pairing-round.template`.
A round parses a G1 and a G2 point, checks their order, and for finite points
multiplies the Miller-loop result into `anum`, `aden`. The accumulators (and
the constant table) stay canonical; every early exit returns (issue #19).
-/

namespace InitECandidate.Solver.GuestBound
open Flapjack

variable {σ : Type} {E : Env σ} {s : St σ} {Q : Result σ → Prop}
  {m m' m0 : Word → Option (PanValue Word)}

/-- Leaving the scope of a declaration of `x`, for locals other than `k1`, `k2`. -/
theorem restore_step2 {li lo : VarName → Option (PanValue Word)} {x k1 k2 : VarName}
    {v : PanValue Word} (h : ∀ y, y ≠ k1 → y ≠ k2 → li y = updatePanValueMap lo x v y) :
    ∀ y, y ≠ k1 → y ≠ k2 → restorePanValueLocal li x (lo x) y = lo y := by
  intro y h1 h2
  unfold restorePanValueLocal
  by_cases hyx : (y == x) = true
  · rw [if_pos hyx, beq_iff_eq.mp hyx]
  · rw [if_neg hyx, h y h1 h2, update_lookup, if_neg hyx]

/-- What a round leaves behind when it ends normally. -/
def RoundPost (st : St σ) (Qb Pb fnum fden anum aden res hp : Word) (r : Result σ) : Prop :=
  match r with
  | .normal l g m f => g = st.globals ∧ f = st.ffi ∧
      (∀ x, x ≠ "i" → x ≠ "nontrivial" → l x = st.locals x) ∧
      (∃ iw' : Word, l "i" = some (.word iw')) ∧
      (∃ nw' : Word, l "nontrivial" = some (.word nw')) ∧
      Bufs hp m [res, aden, anum, fden, fnum, Pb + 768#64, Pb + 384#64, Pb, Qb + 768#64, Qb + 384#64, Qb] hp [res, aden, anum, fden, fnum, Pb + 768#64, Pb + 384#64, Pb, Qb + 768#64, Qb + 384#64, Qb] [aden, anum] m
  | .continued _ _ _ _ | .broke _ _ _ _ => False
  | _ => True

set_option maxHeartbeats 256000000 in
theorem pc_round (hE : GuestEnv E) {st : St σ}
    {g1 g2 t1 t2 Qb Pb fnum fden anum aden res hp Pw iw nw mk : Word}
    (geo : PCGeo g1 g2 t1 t2 Qb Pb fnum fden anum aden res hp)

import Mathlib.Tactic.Ring
import InitECandidate.Solver.GuestBound.FqSub

/-!
# Montgomery multiplication: the carry equations add up

With base `2^32` digits `a`, `b` of the operands, reduction digits `m` and
result digits `u`, `cw`, the fifteen column equations of `fq_mul` give
`A * B + M * p = 2^256 * R`.
-/

namespace InitECandidate.Solver.GuestBound

set_option exponentiation.threshold 1000 in
theorem mont_expand (a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 : Nat) :
    (a0 * 1 + a1 * 2 ^ 32 + a2 * 2 ^ 64 + a3 * 2 ^ 96 + a4 * 2 ^ 128 + a5 * 2 ^ 160 + a6 * 2 ^ 192 + a7 * 2 ^ 224) * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a0 * b0 * 1 + a0 * b1 * 2 ^ 32 + a0 * b2 * 2 ^ 64 + a0 * b3 * 2 ^ 96 + a0 * b4 * 2 ^ 128 + a0 * b5 * 2 ^ 160 + a0 * b6 * 2 ^ 192 + a0 * b7 * 2 ^ 224 + a1 * b0 * 2 ^ 32 + a1 * b1 * 2 ^ 64 + a1 * b2 * 2 ^ 96 + a1 * b3 * 2 ^ 128 + a1 * b4 * 2 ^ 160 + a1 * b5 * 2 ^ 192 + a1 * b6 * 2 ^ 224 + a1 * b7 * 2 ^ 256 + a2 * b0 * 2 ^ 64 + a2 * b1 * 2 ^ 96 + a2 * b2 * 2 ^ 128 + a2 * b3 * 2 ^ 160 + a2 * b4 * 2 ^ 192 + a2 * b5 * 2 ^ 224 + a2 * b6 * 2 ^ 256 + a2 * b7 * 2 ^ 288 + a3 * b0 * 2 ^ 96 + a3 * b1 * 2 ^ 128 + a3 * b2 * 2 ^ 160 + a3 * b3 * 2 ^ 192 + a3 * b4 * 2 ^ 224 + a3 * b5 * 2 ^ 256 + a3 * b6 * 2 ^ 288 + a3 * b7 * 2 ^ 320 + a4 * b0 * 2 ^ 128 + a4 * b1 * 2 ^ 160 + a4 * b2 * 2 ^ 192 + a4 * b3 * 2 ^ 224 + a4 * b4 * 2 ^ 256 + a4 * b5 * 2 ^ 288 + a4 * b6 * 2 ^ 320 + a4 * b7 * 2 ^ 352 + a5 * b0 * 2 ^ 160 + a5 * b1 * 2 ^ 192 + a5 * b2 * 2 ^ 224 + a5 * b3 * 2 ^ 256 + a5 * b4 * 2 ^ 288 + a5 * b5 * 2 ^ 320 + a5 * b6 * 2 ^ 352 + a5 * b7 * 2 ^ 384 + a6 * b0 * 2 ^ 192 + a6 * b1 * 2 ^ 224 + a6 * b2 * 2 ^ 256 + a6 * b3 * 2 ^ 288 + a6 * b4 * 2 ^ 320 + a6 * b5 * 2 ^ 352 + a6 * b6 * 2 ^ 384 + a6 * b7 * 2 ^ 416 + a7 * b0 * 2 ^ 224 + a7 * b1 * 2 ^ 256 + a7 * b2 * 2 ^ 288 + a7 * b3 * 2 ^ 320 + a7 * b4 * 2 ^ 352 + a7 * b5 * 2 ^ 384 + a7 * b6 * 2 ^ 416 + a7 * b7 * 2 ^ 448 := by
  have h0 : ∀ a : Nat, a * 1 * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a * b0 * 1 + a * b1 * 2 ^ 32 + a * b2 * 2 ^ 64 + a * b3 * 2 ^ 96 + a * b4 * 2 ^ 128 + a * b5 * 2 ^ 160 + a * b6 * 2 ^ 192 + a * b7 * 2 ^ 224 := by
    intro a
    ring
  have h1 : ∀ a : Nat, a * 2 ^ 32 * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a * b0 * 2 ^ 32 + a * b1 * 2 ^ 64 + a * b2 * 2 ^ 96 + a * b3 * 2 ^ 128 + a * b4 * 2 ^ 160 + a * b5 * 2 ^ 192 + a * b6 * 2 ^ 224 + a * b7 * 2 ^ 256 := by
    intro a
    ring
  have h2 : ∀ a : Nat, a * 2 ^ 64 * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a * b0 * 2 ^ 64 + a * b1 * 2 ^ 96 + a * b2 * 2 ^ 128 + a * b3 * 2 ^ 160 + a * b4 * 2 ^ 192 + a * b5 * 2 ^ 224 + a * b6 * 2 ^ 256 + a * b7 * 2 ^ 288 := by
    intro a
    ring
  have h3 : ∀ a : Nat, a * 2 ^ 96 * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a * b0 * 2 ^ 96 + a * b1 * 2 ^ 128 + a * b2 * 2 ^ 160 + a * b3 * 2 ^ 192 + a * b4 * 2 ^ 224 + a * b5 * 2 ^ 256 + a * b6 * 2 ^ 288 + a * b7 * 2 ^ 320 := by
    intro a
    ring
  have h4 : ∀ a : Nat, a * 2 ^ 128 * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a * b0 * 2 ^ 128 + a * b1 * 2 ^ 160 + a * b2 * 2 ^ 192 + a * b3 * 2 ^ 224 + a * b4 * 2 ^ 256 + a * b5 * 2 ^ 288 + a * b6 * 2 ^ 320 + a * b7 * 2 ^ 352 := by
    intro a
    ring
  have h5 : ∀ a : Nat, a * 2 ^ 160 * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a * b0 * 2 ^ 160 + a * b1 * 2 ^ 192 + a * b2 * 2 ^ 224 + a * b3 * 2 ^ 256 + a * b4 * 2 ^ 288 + a * b5 * 2 ^ 320 + a * b6 * 2 ^ 352 + a * b7 * 2 ^ 384 := by
    intro a
    ring
  have h6 : ∀ a : Nat, a * 2 ^ 192 * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a * b0 * 2 ^ 192 + a * b1 * 2 ^ 224 + a * b2 * 2 ^ 256 + a * b3 * 2 ^ 288 + a * b4 * 2 ^ 320 + a * b5 * 2 ^ 352 + a * b6 * 2 ^ 384 + a * b7 * 2 ^ 416 := by
    intro a
    ring
  have h7 : ∀ a : Nat, a * 2 ^ 224 * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) =
      a * b0 * 2 ^ 224 + a * b1 * 2 ^ 256 + a * b2 * 2 ^ 288 + a * b3 * 2 ^ 320 + a * b4 * 2 ^ 352 + a * b5 * 2 ^ 384 + a * b6 * 2 ^ 416 + a * b7 * 2 ^ 448 := by
    intro a
    ring
  simp only [Nat.add_mul, h0, h1, h2, h3, h4, h5, h6, h7]
  omega

set_option exponentiation.threshold 1000 in
set_option maxHeartbeats 16000000 in
theorem mont_identity (a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 m0 m1 m2 m3 m4 m5 m6 m7 u0 u1 u2 u3 u4 u5 u6 cw c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 : Nat)
    (e0 : 2 ^ 32 * c0 = a0 * b0 + m0 * 3632069959)
    (e1 : 2 ^ 32 * c1 = (a0 * b1 + (a1 * b0 + m0 * 1008765974)) + c0 + m1 * 3632069959)
    (e2 : 2 ^ 32 * c2 = (a0 * b2 + (a1 * b1 + (a2 * b0 + (m0 * 1752287885 + m1 * 1008765974)))) + c1 + m2 * 3632069959)
    (e3 : 2 ^ 32 * c3 = (a0 * b3 + (a1 * b2 + (a2 * b1 + (a3 * b0 + (m0 * 2541841041 + (m1 * 1752287885 + m2 * 1008765974)))))) + c2 + m3 * 3632069959)
    (e4 : 2 ^ 32 * c4 = (a0 * b4 + (a1 * b3 + (a2 * b2 + (a3 * b1 + (a4 * b0 + (m0 * 2172737629 + (m1 * 2541841041 + (m2 * 1752287885 + m3 * 1008765974)))))))) + c3 + m4 * 3632069959)
    (e5 : 2 ^ 32 * c5 = (a0 * b5 + (a1 * b4 + (a2 * b3 + (a3 * b2 + (a4 * b1 + (a5 * b0 + (m0 * 3092268470 + (m1 * 2172737629 + (m2 * 2541841041 + (m3 * 1752287885 + m4 * 1008765974)))))))))) + c4 + m5 * 3632069959)
    (e6 : 2 ^ 32 * c6 = (a0 * b6 + (a1 * b5 + (a2 * b4 + (a3 * b3 + (a4 * b2 + (a5 * b1 + (a6 * b0 + (m0 * 3778125865 + (m1 * 3092268470 + (m2 * 2172737629 + (m3 * 2541841041 + (m4 * 1752287885 + m5 * 1008765974)))))))))))) + c5 + m6 * 3632069959)
    (e7 : 2 ^ 32 * c7 = (a0 * b7 + (a1 * b6 + (a2 * b5 + (a3 * b4 + (a4 * b3 + (a5 * b2 + (a6 * b1 + (a7 * b0 + (m0 * 811880050 + (m1 * 3778125865 + (m2 * 3092268470 + (m3 * 2172737629 + (m4 * 2541841041 + (m5 * 1752287885 + m6 * 1008765974)))))))))))))) + c6 + m7 * 3632069959)
    (e8 : 2 ^ 32 * c8 + u0 = (a1 * b7 + (a2 * b6 + (a3 * b5 + (a4 * b4 + (a5 * b3 + (a6 * b2 + (a7 * b1 + (m1 * 811880050 + (m2 * 3778125865 + (m3 * 3092268470 + (m4 * 2172737629 + (m5 * 2541841041 + (m6 * 1752287885 + m7 * 1008765974))))))))))))) + c7)
    (e9 : 2 ^ 32 * c9 + u1 = (a2 * b7 + (a3 * b6 + (a4 * b5 + (a5 * b4 + (a6 * b3 + (a7 * b2 + (m2 * 811880050 + (m3 * 3778125865 + (m4 * 3092268470 + (m5 * 2172737629 + (m6 * 2541841041 + m7 * 1752287885))))))))))) + c8)
    (e10 : 2 ^ 32 * c10 + u2 = (a3 * b7 + (a4 * b6 + (a5 * b5 + (a6 * b4 + (a7 * b3 + (m3 * 811880050 + (m4 * 3778125865 + (m5 * 3092268470 + (m6 * 2172737629 + m7 * 2541841041))))))))) + c9)
    (e11 : 2 ^ 32 * c11 + u3 = (a4 * b7 + (a5 * b6 + (a6 * b5 + (a7 * b4 + (m4 * 811880050 + (m5 * 3778125865 + (m6 * 3092268470 + m7 * 2172737629))))))) + c10)
    (e12 : 2 ^ 32 * c12 + u4 = (a5 * b7 + (a6 * b6 + (a7 * b5 + (m5 * 811880050 + (m6 * 3778125865 + m7 * 3092268470))))) + c11)
    (e13 : 2 ^ 32 * c13 + u5 = (a6 * b7 + (a7 * b6 + (m6 * 811880050 + m7 * 3778125865))) + c12)
    (e14 : 2 ^ 32 * cw + u6 = (a7 * b7 + m7 * 811880050) + c13)
    :
    (a0 * 1 + a1 * 2 ^ 32 + a2 * 2 ^ 64 + a3 * 2 ^ 96 + a4 * 2 ^ 128 + a5 * 2 ^ 160 + a6 * 2 ^ 192 + a7 * 2 ^ 224) * (b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224) + (m0 * 1 + m1 * 2 ^ 32 + m2 * 2 ^ 64 + m3 * 2 ^ 96 + m4 * 2 ^ 128 + m5 * 2 ^ 160 + m6 * 2 ^ 192 + m7 * 2 ^ 224) * bnP =
      2 ^ 256 * (u0 * 1 + u1 * 2 ^ 32 + u2 * 2 ^ 64 + u3 * 2 ^ 96 + u4 * 2 ^ 128 + u5 * 2 ^ 160 + u6 * 2 ^ 192 + cw * 2 ^ 224) := by
  rw [mont_expand]
  simp only [bnP]
  omega

set_option exponentiation.threshold 1000 in
theorem mont_final {A B M R : Nat} (hA : A < bnP) (hB : B < 2 ^ 256) (hM : M < 2 ^ 256)
    (h : A * B + M * bnP = 2 ^ 256 * R) :
    R < 2 * bnP ∧ (if R < bnP then R else R - bnP) < bnP ∧
      (if R < bnP then R else R - bnP) * 2 ^ 256 % bnP = A * B % bnP := by
  have h1 : A * B < bnP * 2 ^ 256 := Nat.mul_lt_mul'' hA hB
  have hp : bnP < 2 ^ 255 := by decide
  have hR : R < 2 * bnP := by
    simp only [bnP] at *
    omega
  refine ⟨hR, ?_⟩
  by_cases hlt : R < bnP
  · rw [if_pos hlt]
    refine ⟨hlt, ?_⟩
    have e : R * 2 ^ 256 = A * B + M * bnP := by rw [h]; ring
    rw [e, Nat.add_mul_mod_self_right]
  · rw [if_neg hlt]
    refine ⟨by omega, ?_⟩
    have e : (R - bnP) * 2 ^ 256 + 2 ^ 256 * bnP = A * B + M * bnP := by
      rw [h]
      have : R = (R - bnP) + bnP := by omega
      generalize R - bnP = d at this ⊢
      rw [this]
      ring
    rw [← Nat.add_mul_mod_self_right ((R - bnP) * 2 ^ 256) (2 ^ 256) bnP, e,
      Nat.add_mul_mod_self_right]

set_option exponentiation.threshold 1000 in
set_option maxHeartbeats 16000000 in
/-- The column equations, for a first operand below `p`: the top carry fits in a
digit, and the once-reduced result is canonical and equals `A * B / 2^256`. -/
theorem mont_spec (a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 m0 m1 m2 m3 m4 m5 m6 m7 u0 u1 u2 u3 u4 u5 u6 cw c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 A B : Nat)
    (e0 : 2 ^ 32 * c0 = a0 * b0 + m0 * 3632069959)
    (e1 : 2 ^ 32 * c1 = (a0 * b1 + (a1 * b0 + m0 * 1008765974)) + c0 + m1 * 3632069959)
    (e2 : 2 ^ 32 * c2 = (a0 * b2 + (a1 * b1 + (a2 * b0 + (m0 * 1752287885 + m1 * 1008765974)))) + c1 + m2 * 3632069959)
    (e3 : 2 ^ 32 * c3 = (a0 * b3 + (a1 * b2 + (a2 * b1 + (a3 * b0 + (m0 * 2541841041 + (m1 * 1752287885 + m2 * 1008765974)))))) + c2 + m3 * 3632069959)
    (e4 : 2 ^ 32 * c4 = (a0 * b4 + (a1 * b3 + (a2 * b2 + (a3 * b1 + (a4 * b0 + (m0 * 2172737629 + (m1 * 2541841041 + (m2 * 1752287885 + m3 * 1008765974)))))))) + c3 + m4 * 3632069959)
    (e5 : 2 ^ 32 * c5 = (a0 * b5 + (a1 * b4 + (a2 * b3 + (a3 * b2 + (a4 * b1 + (a5 * b0 + (m0 * 3092268470 + (m1 * 2172737629 + (m2 * 2541841041 + (m3 * 1752287885 + m4 * 1008765974)))))))))) + c4 + m5 * 3632069959)
    (e6 : 2 ^ 32 * c6 = (a0 * b6 + (a1 * b5 + (a2 * b4 + (a3 * b3 + (a4 * b2 + (a5 * b1 + (a6 * b0 + (m0 * 3778125865 + (m1 * 3092268470 + (m2 * 2172737629 + (m3 * 2541841041 + (m4 * 1752287885 + m5 * 1008765974)))))))))))) + c5 + m6 * 3632069959)
    (e7 : 2 ^ 32 * c7 = (a0 * b7 + (a1 * b6 + (a2 * b5 + (a3 * b4 + (a4 * b3 + (a5 * b2 + (a6 * b1 + (a7 * b0 + (m0 * 811880050 + (m1 * 3778125865 + (m2 * 3092268470 + (m3 * 2172737629 + (m4 * 2541841041 + (m5 * 1752287885 + m6 * 1008765974)))))))))))))) + c6 + m7 * 3632069959)
    (e8 : 2 ^ 32 * c8 + u0 = (a1 * b7 + (a2 * b6 + (a3 * b5 + (a4 * b4 + (a5 * b3 + (a6 * b2 + (a7 * b1 + (m1 * 811880050 + (m2 * 3778125865 + (m3 * 3092268470 + (m4 * 2172737629 + (m5 * 2541841041 + (m6 * 1752287885 + m7 * 1008765974))))))))))))) + c7)
    (e9 : 2 ^ 32 * c9 + u1 = (a2 * b7 + (a3 * b6 + (a4 * b5 + (a5 * b4 + (a6 * b3 + (a7 * b2 + (m2 * 811880050 + (m3 * 3778125865 + (m4 * 3092268470 + (m5 * 2172737629 + (m6 * 2541841041 + m7 * 1752287885))))))))))) + c8)
    (e10 : 2 ^ 32 * c10 + u2 = (a3 * b7 + (a4 * b6 + (a5 * b5 + (a6 * b4 + (a7 * b3 + (m3 * 811880050 + (m4 * 3778125865 + (m5 * 3092268470 + (m6 * 2172737629 + m7 * 2541841041))))))))) + c9)
    (e11 : 2 ^ 32 * c11 + u3 = (a4 * b7 + (a5 * b6 + (a6 * b5 + (a7 * b4 + (m4 * 811880050 + (m5 * 3778125865 + (m6 * 3092268470 + m7 * 2172737629))))))) + c10)
    (e12 : 2 ^ 32 * c12 + u4 = (a5 * b7 + (a6 * b6 + (a7 * b5 + (m5 * 811880050 + (m6 * 3778125865 + m7 * 3092268470))))) + c11)
    (e13 : 2 ^ 32 * c13 + u5 = (a6 * b7 + (a7 * b6 + (m6 * 811880050 + m7 * 3778125865))) + c12)
    (e14 : 2 ^ 32 * cw + u6 = (a7 * b7 + m7 * 811880050) + c13)
    (hAe : a0 * 1 + a1 * 2 ^ 32 + a2 * 2 ^ 64 + a3 * 2 ^ 96 + a4 * 2 ^ 128 + a5 * 2 ^ 160 + a6 * 2 ^ 192 + a7 * 2 ^ 224 = A)
    (hBe : b0 * 1 + b1 * 2 ^ 32 + b2 * 2 ^ 64 + b3 * 2 ^ 96 + b4 * 2 ^ 128 + b5 * 2 ^ 160 + b6 * 2 ^ 192 + b7 * 2 ^ 224 = B)
    (hA : A < bnP) (hB : B < 2 ^ 256)
    (bm0 : m0 < 2 ^ 32) (bm1 : m1 < 2 ^ 32) (bm2 : m2 < 2 ^ 32) (bm3 : m3 < 2 ^ 32) (bm4 : m4 < 2 ^ 32) (bm5 : m5 < 2 ^ 32) (bm6 : m6 < 2 ^ 32) (bm7 : m7 < 2 ^ 32) :
    cw < 2 ^ 32 ∧ ∃ R, R = u0 * 1 + u1 * 2 ^ 32 + u2 * 2 ^ 64 + u3 * 2 ^ 96 + u4 * 2 ^ 128 + u5 * 2 ^ 160 + u6 * 2 ^ 192 + cw * 2 ^ 224 ∧
      (if R < bnP then R else R - bnP) < bnP ∧
      (if R < bnP then R else R - bnP) * 2 ^ 256 % bnP = A * B % bnP := by
  have hid := mont_identity a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 m0 m1 m2 m3 m4 m5 m6 m7 u0 u1 u2 u3 u4 u5 u6 cw c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14
  rw [hAe, hBe] at hid
  have hMb : m0 * 1 + m1 * 2 ^ 32 + m2 * 2 ^ 64 + m3 * 2 ^ 96 + m4 * 2 ^ 128 + m5 * 2 ^ 160 + m6 * 2 ^ 192 + m7 * 2 ^ 224 < 2 ^ 256 := by omega
  obtain ⟨hR2, hfin1, hfin2⟩ := mont_final hA hB hMb hid
  have hp : bnP < 2 ^ 255 := by decide
  exact ⟨by omega, _, rfl, hfin1, hfin2⟩

end InitECandidate.Solver.GuestBound

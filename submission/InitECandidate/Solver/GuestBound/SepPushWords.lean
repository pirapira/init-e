namespace InitECandidate.Solver.GuestBound
open Flapjack

variable {σ : Type} {E : Env σ}

theorem «op_pc_framed» (hE : GuestEnv E) (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "op_pc" E.functions = some (parameters, body))
    (s : St σ) (e sp cap base pv fv gl used pc : Word) (ok : StackOk sp cap base pv fv) :
    WPFt E s body (OpW e sp cap base pv fv gl used pc)
      (PushPost s.ffi e sp cap base pv fv gl used pc 2#64) := by
  have hbody := (fun_of_index 505 hE.functions (by guest_decl_at 505) (by decide +kernel)
    hlookup).1
  subst hbody
  exact pushLoad_framed hE 2#64
    (Exp.op BinOp.add [(Exp.var VarKind.global "ev"), (Exp.const (BitVec.ofNat 64 0))])
    s e sp cap base pv fv gl used pc ok


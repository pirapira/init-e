import InitECandidate.Solver.GuestBound.SepFrameOp

/-!
# Stack handlers under the frame invariant

Generated by `tools/gen-frame-ops.py`. Each handler here either aborts (a trap,
or `EvmErr` with the frame invariant intact and no gas gained) or returns 0
with the frame invariant intact and strictly less gas left.
-/

namespace InitECandidate.Solver.GuestBound
open Flapjack

variable {σ : Type} {E : Env σ}

theorem «op_add_frame» (hE : GuestEnv E) (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "op_add" E.functions = some (parameters, body))
    (s : St σ) (M : Word) (K : Word → Prop) (e fv : Word) (R : Assn) (X0 : OpSt)
    (hok : FrameOk M K fv X0) (h : (FrameOp M K e fv X0 ⋆ R).holds s) :
    WPr E s body (HandlerQ M K e fv R s.ffi X0) := by
  have hbody := (fun_of_index 475 hE.functions (by guest_decl_at 475)
    (by decide +kernel) hlookup).1
  subst hbody
  dsimp only
  have hp : Adv X0 X0 0 := ⟨Nat.le_refl _, Nat.le_refl _⟩
  refine op_pop_step hE hok hp h AcceptsH.refl.abort (fun _ g m hok hp h => ?_)
  refine op_pop_step hE hok hp h AcceptsH.refl.restore.abort (fun _ g m hok hp h => ?_)
  refine op_charge hE 3#64 hok hp h AcceptsH.refl.restore.restore.abort (fun g m hok hp h => ?_)
  refine op_quiet (keepFn_sound (quietKeeper E) hE.functions 6 "u256_add"
      (show keepFn quietLeaf Guest.Software.guestAst 6 "u256_add" = true by decide +kernel))
    (raiseFn_sound _ hE.functions 6 "u256_add"
      (show raiseFn (fun _ => false) Guest.Software.guestAst 6 "u256_add" = true by
        decide +kernel))
    h AcceptsH.refl.restore.restore.abort (fun _ hsh_r h => ?_)
  refine op_push hok hp h AcceptsH.refl.restore.restore.restore.abort
    (stack_push_any_hc hE (arg4_shape (by simp (config := { decide := true }) [update_lookup]) hsh_r) e _ _ _ _ fv hok.ok)
    (fun _ g m hok hp h => ?_)
  refine op_pc_add hE (d := 1#64)
    (by simp [evalArgs_cons, evalArgs_nil, eval_const]) hok hp h
    AcceptsH.refl.restore.restore.restore.abort (fun g m hok hp h => ?_)
  exact op_return hok hp (by decide) h AcceptsH.refl.restore.restore.restore


  refine WPs.dec (w := P1) (of_eval (by lk [hP1])) ?_
  refine WPs.dec (w := P1 + 384#64) (of_eval (by ev [hP1])) ?_
  refine WPs.dec (w := P1 + 768#64) (of_eval (by ev [evalPanOp, hP1])) ?_

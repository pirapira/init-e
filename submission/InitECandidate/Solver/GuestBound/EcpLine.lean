  subst hbody
  dsimp only at h
  refine (?_ : WPs E s _ (BufsRet s pv0 m0 Wr hp All (N :: Dn :: Cn))) r h
  refine WPs.dec (w := 384#64) (of_eval (by ev [evalPanOp, hfld])) ?_

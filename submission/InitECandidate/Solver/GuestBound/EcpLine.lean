import InitECandidate.Solver.GuestBound.FeSet

/-!
# `ecp_linefunc` on `Fq12` points keeps coefficients below `p`

Generated by `tools/gen-ecp-line.py` from `tools/ecp-line.template` (the step
lists follow the source of `ecp_linefunc`). Part of the canonicity chain for
`fq12_inv` (issue #19).
-/

namespace InitECandidate.Solver.GuestBound
open Flapjack

variable {σ : Type} {E : Env σ} {s : St σ} {Q : Result σ → Prop}
  {m m' m0 : Word → Option (PanValue Word)} {Wr : List Word}

/-- A statement behaves like itself followed by `skip`. -/
theorem WPs.of_seq_skip {p : Prog Word} (h : WPs E s (.seq p .skip) Q) : WPs E s p Q := by
  intro r hr
  refine h r (runs_seq.mpr ⟨r, hr, ?_⟩)
  cases r <;> first | exact runs_skip.mpr rfl | rfl

set_option maxHeartbeats 64000000 in
theorem ecp_linefunc12_bufs (hE : GuestEnv E) (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "ecp_linefunc" E.functions = some (parameters, body))
    (s : St σ) (r : Result σ) (N Dn P1 P2 T hp pv0 : Word)
    (m0 : Word → Option (PanValue Word)) (Wr All Cn : List Word)
    (hfld : s.locals "fld" = some (.word 12#64)) (hnum : s.locals "num" = some (.word N))
    (hden : s.locals "den" = some (.word Dn)) (hP1 : s.locals "P1" = some (.word P1))
    (hP2 : s.locals "P2" = some (.word P2)) (hT : s.locals "T" = some (.word T))
    (hg : s.globals "heap_ptr" = some (.word hp))
    (hB0 : Bufs pv0 m0 Wr hp All Cn s.memory)
    (m1a : P1 ∈ Cn) (m1b : P1 + 384#64 ∈ Cn) (m1c : P1 + 768#64 ∈ Cn)
    (m2a : P2 ∈ Cn) (m2b : P2 + 384#64 ∈ Cn) (m2c : P2 + 768#64 ∈ Cn)
    (mta : T ∈ Cn) (mtb : T + 384#64 ∈ Cn) (mtc : T + 768#64 ∈ Cn)
    (hN : N ∈ All) (hD : Dn ∈ All)
    (wN : pv0.toNat ≤ N.toNat ∨ N ∈ Wr) (wD : pv0.toNat ≤ Dn.toNat ∨ Dn ∈ Wr)
    (h : Runs E s body r) :
    Stopped r ∨ BufsRet s pv0 m0 Wr hp All (N :: Dn :: Cn) r := by
  have hbody := (fun_of_index 676 hE.functions (by guest_decl_at 676) (by decide +kernel)

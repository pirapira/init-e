import InitECandidate.Solver.GuestBound.SepBinop

/-!
# The binary stack handlers

Generated by `tools/gen-sep-binops.py`. Each handler whose body is
`binopBody f G` gets its framed specification from `binop_framed`; the callee
is checked to change nothing (`keepFn quietLeaf`) and never to raise
(`raiseFn`).
-/

namespace InitECandidate.Solver.GuestBound
open Flapjack

variable {σ : Type} {E : Env σ}

theorem «op_add_framed» (hE : GuestEnv E) (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "op_add" E.functions = some (parameters, body))
    (s : St σ) (e sp cap base pv fv gl used pc : Word) (ok : StackOk sp cap base pv fv) :
    WPFt E s body (OpW e sp cap base pv fv gl used pc)
      (BinopPost s.ffi e sp cap base pv fv gl used pc 3#64) := by
  have hbody := (fun_of_index 475 hE.functions (by guest_decl_at 475) (by decide +kernel)
    hlookup).1
  subst hbody
  exact binop_framed hE 3#64
    (keepFn_sound (quietKeeper E) hE.functions 6 "u256_add"
      (show keepFn quietLeaf Guest.Software.guestAst 6 "u256_add" = true by decide +kernel))
    (raiseFn_sound _ hE.functions 6 "u256_add"
      (show raiseFn (fun _ => false) Guest.Software.guestAst 6 "u256_add" = true by
        decide +kernel))
    s e sp cap base pv fv gl used pc ok


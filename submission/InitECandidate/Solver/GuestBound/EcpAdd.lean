    (w1 : pv0.toNat ≤ (O + 384#64).toNat ∨ O + 384#64 ∈ Wr)
    (w2 : pv0.toNat ≤ (O + 768#64).toNat ∨ O + 768#64 ∈ Wr)
    (rel1 : O = P1 ∨ O.toNat + 1152 ≤ P1.toNat ∨ P1.toNat + 1152 ≤ O.toNat)
    (rel2 : O = P2 ∨ O.toNat + 1152 ≤ P2.toNat ∨ P2.toNat + 1152 ≤ O.toNat)

   "op_staticcall"]

theorem handlers_proved (hE : GuestEnv E) : ∀ f, f ∈ provedOps → HandlerSpec E f := by
  intro f hf
  simp only [provedOps, List.mem_cons, List.not_mem_nil, or_false] at hf
  rcases hf with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact fun p b hl s M K e fv R X0 hok h => «op_add_frame» hE p b hl s M K e fv R X0 hok h
  · exact fun p b hl s M K e fv R X0 hok h => «op_mul_frame» hE p b hl s M K e fv R X0 hok h
  · exact fun p b hl s M K e fv R X0 hok h => «op_sub_frame» hE p b hl s M K e fv R X0 hok h
  · exact fun p b hl s M K e fv R X0 hok h => «op_signextend_frame» hE p b hl s M K e fv R X0 hok h
  · exact fun p b hl s M K e fv R X0 hok h => «op_lt_frame» hE p b hl s M K e fv R X0 hok h
  · exact fun p b hl s M K e fv R X0 hok h => «op_gt_frame» hE p b hl s M K e fv R X0 hok h

   "op_coinbase", "op_timestamp", "op_number", "op_gaslimit", "op_chainid", "op_prevrandao",
   "op_slotnum"]

/-- The handlers still to be proved. -/
def restOps : List FunName :=
  ["op_div", "op_sdiv", "op_mod", "op_smod", "op_addmod", "op_mulmod", "op_exp", "op_clz",
   "op_keccak", "op_stop", "op_mstore", "op_mstore8", "op_mload", "op_mcopy", "op_push",

/-- The dispatcher: it falls through with the state unchanged (which its caller
turns into an error), or ends as a handler does. -/
theorem op_dispatch_frame (hE : GuestEnv E) (hrest : ∀ f, f ∈ restOps → HandlerSpec E f)
    (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "op_dispatch" E.functions = some (parameters, body))
    (s : St σ) (M : Word) (K : Word → Prop) (e fv : Word) (R : Assn) (X0 : OpSt)
    (hok : FrameOk M K fv X0) (h : (FrameOp M K e fv X0 ⋆ R).holds s) :
    WPr E s body (fun r => match r with
      | .normal l g m f => (⟨l, g, m, f⟩ : St σ) = s
      | r => HandlerQ M K e fv R s.ffi X0 r) := by
  have hbody := (fun_of_index 577 hE.functions (by guest_decl_at 577)
    (by decide +kernel) hlookup).1
  subst hbody
  have hall : ∀ f, (provedOps ++ restOps).contains f = true → HandlerSpec E f := by
    intro f hf
    rcases List.mem_append.mp (List.contains_iff_mem.mp hf) with h1 | h2
    · exact handlers_proved hE f h1
    · exact hrest f h2
  refine tree_sound (ok := fun f => (provedOps ++ restOps).contains f) (P := fun a => a = s)
    (Q := HandlerQ M K e fv R s.ffi X0) ?_ ?_ ?_ _ (by decide +kernel) s rfl
  · rintro f args hf _ rfl
    exact handler_leaf (hall f hf) args _ M K e fv R X0 hok h
  · rintro _ k rfl
    exact Or.inl (Or.inr ⟨X0, 0, hok, ⟨Nat.le_refl _, Nat.le_refl _⟩,
      Assn.holds_congr rfl rfl h, _, _, _, _, rfl⟩)
  · rintro l g m f ((ht | ⟨_, _, _, _, _, _, _, _, _, hC⟩) | ⟨_, _, _, _, _, _, _, _, _, hC⟩)
    · exact ht.elim
    · cases hC
    · cases hC

end InitECandidate.Solver.GuestBound

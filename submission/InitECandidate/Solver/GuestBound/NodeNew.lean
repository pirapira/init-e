/-!
# Trie node constructors write only their own block

`node_new_hashed`, `node_new_leaf`, `node_new_ext` and `node_new_branch`
allocate a block and fill its fields. `FreshRet s size r` says a run returned the old heap pointer,
advanced the heap pointer past `size` bytes, and left memory outside the new
block as it was. These are the first of the "writes only fresh memory" facts
the witness-decoding loop needs (issue #21). Generated by a throwaway script
from the function bodies; arguments are assumed to be words, which is what the
callers pass.
-/

namespace InitECandidate.Solver.GuestBound
open Flapjack

variable {σ : Type} {E : Env σ}

/-- The run returned the old heap pointer `pv` after allocating `size` bytes
there, and changed no memory outside `[pv, pv + size)`. -/
def FreshRet (s : St σ) (size : Nat) (r : Result σ) : Prop :=
  ∃ l pv qv m', s.globals "heap_ptr" = some (.word pv) ∧
    r = .returned l (updatePanValueMap s.globals "heap_ptr" (.word qv)) m' s.ffi [.word pv] ∧
    pv.toNat + size ≤ qv.toNat ∧ InHeap qv ∧
    ∀ x : Word, (x.toNat < pv.toNat ∨ pv.toNat + size ≤ x.toNat) → m' x = s.memory x

theorem add_lit_lt {pv qv : Word} {k size : Nat} (hk : k < size) (hs : size < 2 ^ 32)
    (h1 : pv.toNat + size ≤ qv.toNat) (h2 : qv.toNat ≤ 2952790016) :
    (pv + BitVec.ofNat 64 k).toNat = pv.toNat + k := by
  rw [BitVec.toNat_add, BitVec.toNat_ofNat]
  have : k % 2 ^ 64 = k := Nat.mod_eq_of_lt (by omega)
  rw [this]
  exact Nat.mod_eq_of_lt (by omega)

theorem node_new_hashed_fresh (hE : GuestEnv E) (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "node_new_hashed" E.functions = some (parameters, body))
    (s : St σ) (r : Result σ) {w_hash : Word} (h_hash : s.locals "hash" = some (.word w_hash))
    (hH : HeapOk s.globals) (h : Runs E s body r) : Stopped r ∨ FreshRet s 32 r := by
  have hbody := (fun_of_index 255 hE.functions (by guest_decl_at 255) (by decide +kernel)
    hlookup).1
  subst hbody
  dsimp only at h
  obtain ⟨pv, hp, hpH⟩ := hH
  refine (?_ : WPs E s _ (FreshRet s 32)) r h
  refine WPs.decCall_alloc hE (nv := 32#64) (eval_const _ _) hp hpH (fun qv h1 h2 => ?_)
  rw [show (32#64 : Word).toNat = 32 by decide] at h1
  try dsimp only
  refine WPs.seq_store hE (addr := pv + 0#64) (by ev []) (of_eval (w := 0#64) (eval_const _ _)) ?_
  try dsimp only
  refine WPs.seq_store hE (addr := pv + 8#64) (by ev []) (of_eval (w := 0#64) (eval_const _ _)) ?_
  try dsimp only
  refine WPs.seq_store hE (addr := pv + 16#64) (by ev []) (of_eval (w := 0#64) (eval_const _ _)) ?_
  try dsimp only
  refine WPs.seq_store hE (addr := pv + 24#64) (by ev []) (of_eval (w := w_hash) (by lk [h_hash])) ?_
  try dsimp only
  refine WPs.ret (w := pv) (of_eval (by lk [])) ?_
  simp only [restorePanValueFfiLocal]
  have e0 := add_lit_lt (pv := pv) (qv := qv) (k := 0) (size := 32) (by omega) (by omega) h1 h2.1
  have e8 := add_lit_lt (pv := pv) (qv := qv) (k := 8) (size := 32) (by omega) (by omega) h1 h2.1
  have e16 := add_lit_lt (pv := pv) (qv := qv) (k := 16) (size := 32) (by omega) (by omega) h1 h2.1
  have e24 := add_lit_lt (pv := pv) (qv := qv) (k := 24) (size := 32) (by omega) (by omega) h1 h2.1
  refine ⟨_, pv, qv, _, hp, rfl, h1, h2, fun x hx => ?_⟩
  rw [setCell_ne _ (by intro hh; have := congrArg BitVec.toNat hh; rw [e24] at this; omega), setCell_ne _ (by intro hh; have := congrArg BitVec.toNat hh; rw [e16] at this; omega), setCell_ne _ (by intro hh; have := congrArg BitVec.toNat hh; rw [e8] at this; omega), setCell_ne _ (by intro hh; have := congrArg BitVec.toNat hh; rw [e0] at this; omega)]


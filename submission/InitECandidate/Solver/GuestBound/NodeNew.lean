  try dsimp only
  refine WPs.seq_store hE (addr := pv + 56#64) (by ev []) (of_eval (w := w_vlen) (by lk [h_vlen])) ?_
  try dsimp only
  refine WPs.ret (w := pv) (of_eval (by lk [])) ?_
  simp only [restorePanValueFfiLocal]
  have e0 := add_lit_lt (pv := pv) (qv := qv) (k := 0) (size := 64) (by omega) (by omega) h1 h2.1

  have e24 := add_lit_lt (pv := pv) (qv := qv) (k := 24) (size := 64) (by omega) (by omega) h1 h2.1
  have e32 := add_lit_lt (pv := pv) (qv := qv) (k := 32) (size := 64) (by omega) (by omega) h1 h2.1
  have e40 := add_lit_lt (pv := pv) (qv := qv) (k := 40) (size := 64) (by omega) (by omega) h1 h2.1
  have e48 := add_lit_lt (pv := pv) (qv := qv) (k := 48) (size := 64) (by omega) (by omega) h1 h2.1
  have e56 := add_lit_lt (pv := pv) (qv := qv) (k := 56) (size := 64) (by omega) (by omega) h1 h2.1
  refine ⟨_, pv, qv, _, hp, rfl, h1, h2, fun x hx => ?_⟩

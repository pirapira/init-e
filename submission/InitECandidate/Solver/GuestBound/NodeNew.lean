/-- What a returning `memzero` on an aligned block of a multiple of 8 bytes leaves. -/
theorem memzero_frame_ret (hE : GuestEnv E) {s : St σ} {vs : List (PanValue Word)}
    {g : VarName → Option (PanValue Word)} {m : Word → Option (PanValue Word)}
    {ffi : FfiState σ} {e1 e2 : Exp Word} {dst nW : Word}
    (h : CalleeRet E s "memzero" [e1, e2] vs g m ffi)
    (h1 : E.eval s e1 = some (.word dst)) (h2 : E.eval s e2 = some (.word nW))
    (hal : dst.toNat % 8 = 0) (hn8 : nW.toNat % 8 = 0)
    (h64 : dst.toNat + nW.toNat + 32 < 2 ^ 64) :
    g = s.globals ∧ ffi = s.ffi ∧
      ∀ x : Word, (x.toNat < dst.toNat ∨ dst.toNat + nW.toNat ≤ x.toNat) → m x = s.memory x := by
  obtain ⟨parameters, body, values, cl, l, hlookup, hvalues, hbind, hrun⟩ := h
  have hparams := (fun_of_index 17 hE.functions (by guest_decl_at 17) (by decide +kernel)
    hlookup).2
  simp only [evalArgs_cons, evalArgs_nil, h1, h2, Option.map_some, Option.some.injEq] at hvalues
  subst hvalues
  rw [hparams] at hbind
  simp [bindPanValueParameters] at hbind
  rcases memzero_frame8 hE parameters body hlookup ⟨cl, s.globals, s.memory, s.ffi⟩ _ dst nW
    (by rw [← hbind]; simp (config := { decide := true }) [updatePanValueMap])
    (by rw [← hbind]; simp (config := { decide := true }) [updatePanValueMap]) hal hn8 h64 hrun
    with hst | ⟨l', m', heq, hfr⟩
  · exact absurd hst (fun h => h)
  · cases heq
    exact ⟨rfl, rfl, hfr⟩

theorem node_new_branch_fresh (hE : GuestEnv E) (parameters : List VarName) (body : Prog Word)
    (hlookup : lookupPanFunction "node_new_branch" E.functions = some (parameters, body))
    (s : St σ) (r : Result σ) (hH : HeapOk s.globals) (h : Runs E s body r) :
    Stopped r ∨ FreshRet s 176 r := by
  have hbody := (fun_of_index 258 hE.functions (by guest_decl_at 258) (by decide +kernel)
    hlookup).1
  subst hbody
  dsimp only at h
  obtain ⟨pv, hp, hpH⟩ := hH
  refine (?_ : WPs E s _ (FreshRet s 176)) r h
  refine WPs.decCall_alloc hE (nv := 176#64) (eval_const _ _) hp hpH (fun qv h1 h2 => ?_)
  rw [show (176#64 : Word).toNat = 176 by decide] at h1
  try dsimp only
  refine WPs.seq_call_ret (fun vs g m1 ffi hret => ?_)
  obtain ⟨hg, hf, hfr⟩ := memzero_frame_ret hE hret (dst := pv) (nW := 176#64) (by lk [])
    (eval_const _ _) hpH.2 (by decide) (by
      rw [show (176#64 : Word).toNat = 176 by decide]
      have := h2.1
      omega)
  subst g ffi
  rw [show (176#64 : Word).toNat = 176 by decide] at hfr
  try dsimp only
  refine WPs.seq_store hE (addr := pv + 0#64) (by ev []) (of_eval (w := 3#64) (eval_const _ _)) ?_
  try dsimp only
  refine WPs.ret (w := pv) (of_eval (by lk [])) ?_
  simp only [restorePanValueFfiLocal]
  have e0 := add_lit_lt (pv := pv) (qv := qv) (k := 0) (size := 176) (by omega) (by omega) h1 h2.1
  refine ⟨_, pv, qv, _, hp, rfl, h1, h2, fun x hx => ?_⟩
  rw [setCell_ne _ (by intro hh; have := congrArg BitVec.toNat hh; rw [e0] at this; omega)]
  exact hfr x hx

